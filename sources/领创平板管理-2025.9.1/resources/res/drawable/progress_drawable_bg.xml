<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="20.0dp" />
            <solid android:color="@color/network_progress_bg_color" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="20.0dp" />
                <gradient android:startColor="@color/network_progress_color" android:endColor="@color/white" android:angle="45.0" android:centerX="0.0" android:centerY="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>
