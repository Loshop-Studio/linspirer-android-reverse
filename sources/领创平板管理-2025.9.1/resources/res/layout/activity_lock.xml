<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@drawable/launcher_bg" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:id="@id/admin_click" android:layout_width="@dimen/dp_50" android:layout_height="@dimen/dp_50" android:onClick="onClick" />
    <ImageView android:id="@id/lock_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_75" android:src="@drawable/lock_image" android:layout_centerHorizontal="true" />
    <EditText android:textSize="@dimen/sp_15" android:textColor="@color/white" android:textColorHint="@color/alpha_40_white" android:id="@id/pwd" android:background="@drawable/account_password_bg" android:paddingLeft="@dimen/dp_16" android:layout_width="@dimen/dp_355" android:layout_height="@dimen/dp_42" android:layout_marginTop="@dimen/dp_45" android:hint="@string/input_your_password" android:singleLine="true" android:maxLength="12" android:drawableLeft="@drawable/icon_password" android:drawablePadding="@dimen/dp_15" android:layout_below="@id/lock_image" android:layout_centerHorizontal="true" android:inputType="textPassword" android:imeOptions="actionDone" android:textCursorDrawable="@null" />
    <TextView android:textSize="@dimen/sp_14" android:textColor="@color/white" android:id="@id/lock_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_15" android:text="@string/lock_tip" android:layout_below="@id/pwd" android:layout_alignLeft="@id/pwd" />
    <Button android:textSize="@dimen/sp_15" android:textColor="@android:color/white" android:id="@id/btn_login" android:background="@color/btn_login_color" android:layout_width="@dimen/dp_355" android:layout_height="@dimen/dp_42" android:layout_marginTop="@dimen/dp_40" android:text="@string/text_login" android:layout_below="@id/lock_tip" android:layout_centerHorizontal="true" android:imeOptions="actionDone" android:onClick="onClick" />
    <RelativeLayout android:id="@id/net_set" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/dp_17" android:layout_alignParentBottom="true">
        <TextView android:textSize="@dimen/sp_12" android:textColor="@color/admin_itme_bg" android:id="@id/info" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_25" android:layout_alignParentLeft="true" />
        <ImageView android:id="@id/net_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/icon_wifi" android:layout_toLeftOf="@id/net_text" android:layout_centerVertical="true" android:onClick="onClick" />
        <TextView android:textSize="@dimen/sp_14" android:textColor="@color/net_blue" android:id="@id/net_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_4" android:layout_marginRight="@dimen/dp_10" android:text="@string/text_network_settings" android:layout_alignParentRight="true" android:onClick="onClick" />
    </RelativeLayout>
</RelativeLayout>
