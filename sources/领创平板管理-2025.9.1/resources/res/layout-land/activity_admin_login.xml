<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="@color/white" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:orientation="horizontal" android:id="@id/linearLayout1" android:background="@color/blue" android:layout_width="match_parent" android:layout_height="@dimen/dp_48">
        <TextView android:textSize="@dimen/sp_19" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/admin_login" android:layout_centerInParent="true" />
    </RelativeLayout>
    <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true">
        <Button android:textSize="@dimen/sp_15" android:textColor="@color/white" android:id="@id/scan_code_button" android:background="@drawable/btn_round_corner2_bg" android:layout_width="@dimen/dp_320" android:layout_height="@dimen/dp_42" android:text="@string/scan_code_login" />
        <TextView android:textSize="@dimen/sp_15" android:textColor="@color/gesture_pwd_hint_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_30" android:text="@string/login_qr_code" />
    </LinearLayout>
    <RelativeLayout android:id="@id/bottomView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_25" android:layout_marginRight="@dimen/dp_25" android:layout_marginBottom="@dimen/dp_16" android:layout_alignParentBottom="true">
        <TextView android:textSize="@dimen/sp_12" android:textColor="@color/admin_login_text_color" android:gravity="center" android:id="@id/check_update" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/text_check_update" android:drawableLeft="@drawable/icon_update" android:drawablePadding="@dimen/dp_8" />
        <TextView android:textSize="@dimen/sp_12" android:textColor="@color/admin_login_text_color" android:id="@id/version_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_10" android:text="@string/unknown" android:layout_toRightOf="@id/check_update" android:layout_centerVertical="true" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/sync_time_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true">
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/icon_sync_time" />
            <TextView android:textSize="@dimen/sp_12" android:textColor="@color/admin_login_text_color" android:gravity="center" android:id="@id/sync_time_admin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_8" android:text="@string/text_sync_time" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
